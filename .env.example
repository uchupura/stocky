# .env 로 복사한 뒤 값을 채워 넣으세요:  cp .env.example .env
# ⚠️ .env 는 절대 커밋하지 마세요 (.gitignore 에 등록됨)

# ----- 브라우저에 전달됨 (공개용) -----
# Supabase 대시보드 → Project Settings → API
VITE_SUPABASE_URL=
VITE_SUPABASE_ANON_KEY=

# ----- 서버 전용 (VITE_ 접두사 없음 → 브라우저로 전달 안 됨) -----
# 한국투자증권 KIS Developers → API 신청 내역에서 확인
KIS_APP_KEY=
KIS_APP_SECRET=
# mock(모의투자) 또는 real(실전). 실전 키는 주문 권한이 있으니 유출 주의
KIS_ENV=mock
# Supabase → Project Settings → API Keys → service_role (RLS 무시하는 관리자 키, 서버에서만 사용)
SUPABASE_SERVICE_ROLE_KEY=

# 네이버 로그인 — developers.naver.com → 내 애플리케이션 (서버 전용)
NAVER_CLIENT_ID=
NAVER_CLIENT_SECRET=
# 포트폴리오를 볼 수 있는 네이버 계정의 "연락처 이메일" (쉼표로 여러 개)
ALLOWED_EMAILS=
